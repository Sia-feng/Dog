MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k3.1-pro-highspeed
PORT=4173
ARK_API_KEY=
SEEDANCE_MODEL=doubao-seedance-2-5-260628
# 火山引擎（豆包）声音复刻 2.0 + 语音合成。来自火山语音技术控制台，与 Kimi / Ark 是不同产品与密钥。
# VOLC_SPEAKER_ID 需在控制台购买「声音复刻 2.0」音色后获得（形如 S_xxxxxxxx），再用本人录音训练。
VOLC_TTS_APPID=
VOLC_TTS_TOKEN=
VOLC_SPEAKER_ID=
VOLC_TTS_CLUSTER=volcano_icl
# 默认「调皮小鬼」音色包：填一个火山预置童声/男孩音色 ID（如 zh_male_* 之类，以控制台可用音色为准）。
# 这是通用预设童声，不是任何具体卡通角色或其配音演员的声音。预置音色 cluster 通常为 volcano_tts。
VOLC_VOICE_PLAYFUL=
VOLC_PLAYFUL_CLUSTER=volcano_tts
